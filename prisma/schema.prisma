generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Mod {
  id          String   @id @default(cuid())
  name        String
  description String
  developer   String
  downloadUrl String
  sourceUrl   String
  isTrusted   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
