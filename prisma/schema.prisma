generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Hosted Postgres (Neon, Supabase, ...) serves queries through a connection
  // pooler that cannot run DDL. `directUrl` is used by `prisma migrate` only;
  // set it to the unpooled connection string. Locally the two are the same.
  directUrl = env("DIRECT_DATABASE_URL")
}

// Unlike `Listing.category` — which is a validated String because the list is
// owned by src/lib/categories.ts and changes without a migration — roles are a
// closed set baked into authorization logic, so a native enum fits.
enum Role {
  USER
  ADMIN
}

/// What a listing costs. FREEMIUM is included because a free tier plus a paid
/// "premium" is the normal shape for clients in this space — without it, admins
/// would have to mislabel those as one or the other.
enum Pricing {
  FREE
  PAID
  FREEMIUM
}

/// The two shapes a pack is published in. A closed set baked into the download
/// route and the upload handler, so an enum rather than a validated String.
enum ModpackFileKind {
  MRPACK
  ZIP
}

/// A downloadable modpack.
///
/// Was a hardcoded object in src/lib/modpack.ts until packs went plural.
/// Everything an admin edits lives here; the *presentation* of the mod groups
/// (their titles, blurbs and colours) stays in code, because that is curated
/// copy rather than data — see MOD_GROUPS in src/lib/modpack.ts.
model Modpack {
  id      String @id @default(cuid())
  /// URL segment, and the stable half of every uploaded filename.
  slug    String @unique
  name    String
  /// One-line pitch under the title.
  summary String

  minecraft String
  loader    String
  version   String

  /// Unpublished packs are invisible to the public and undownloadable — a pack
  /// exists as a record before its (large) files finish uploading, and half an
  /// upload is not something to serve.
  isPublished Boolean @default(false)
  /// Ascending. Lowest published pack is the one legacy /download/mrpack links
  /// still resolve to.
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ModpackFile[]
  mods  ModpackMod[]
}

/// One uploaded artefact of a pack. At most one per kind — re-uploading
/// replaces both the row and the file on disk.
model ModpackFile {
  id        String  @id @default(cuid())
  modpackId String
  modpack   Modpack @relation(fields: [modpackId], references: [id], onDelete: Cascade)

  kind     ModpackFileKind
  /// Name on disk inside the downloads directory. Never taken from the client:
  /// it is built from the slug, kind and version, so an upload cannot escape
  /// the directory or overwrite an unrelated file.
  filename String
  bytes    Int

  uploadedAt DateTime @default(now())

  @@unique([modpackId, kind])
}

/// One mod inside a pack.
///
/// Read out of the uploaded .mrpack rather than typed in — the manifest already
/// lists every file with its Modrinth project id, so retyping 25 rows per
/// release would only be a chance to get them wrong. `group` is the exception:
/// it is a curation call the manifest cannot make, so it is carried over from
/// the previous upload where the mod is recognised, and set by hand otherwise.
model ModpackMod {
  id        String  @id @default(cuid())
  modpackId String
  modpack   Modpack @relation(fields: [modpackId], references: [id], onDelete: Cascade)

  name        String
  version     String
  /// Modrinth project id, or null when the pack ships the jar directly.
  modrinth    String?
  /// True for jars in the .mrpack's overrides/ — files Modrinth will not host,
  /// which on this site is a warning worth showing rather than a detail.
  bundledOnly Boolean @default(false)

  /// Key from MOD_GROUPS in src/lib/modpack.ts.
  group     String
  sortOrder Int    @default(0)

  @@index([modpackId])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Normally set only once a DM code has been verified, which is what makes a
  // linked account mean something — reviews and listing ownership both require
  // one. discordId is the snowflake and is the durable identifier;
  // discordUsername is a display cache, since Discord usernames can change.
  discordId       String?   @unique
  discordUsername String?
  discordLinkedAt DateTime?

  /// True when an admin set the link by hand instead of the user proving it
  /// over DM.
  ///
  /// Exists so the guarantee above stays checkable. Without it a link an admin
  /// asserted and a link the user proved look identical, and "tied to a
  /// verified Discord identity" quietly stops being true for an unknown subset
  /// of accounts. Verifying properly later clears it.
  discordLinkedByAdmin Boolean @default(false)

  /// Null means the username has never been changed, so the cooldown does not
  /// apply to a first change.
  usernameChangedAt DateTime?

  /// When an admin barred this account from posting reviews, or null.
  ///
  /// A timestamp rather than a boolean, for the same reason `Listing.unlistedAt`
  /// is one: "since when" is the first thing anyone reviewing a ban asks.
  ///
  /// Bans are forward-looking only. Reviews the account already posted stay
  /// visible and keep counting towards ratings — they were written before the
  /// abuse and deleting them would silently rewrite listings' scores. Removing
  /// an individual bad review is a separate, deliberate act.
  reviewBannedAt  DateTime?
  /// Admin-facing note on why. Never shown to the banned user or the public: it
  /// is moderation shorthand, not a published accusation.
  reviewBanReason String?

  /// When this user last opened the notification centre.
  ///
  /// The whole of "read state" is this one column. Notifications are derived at
  /// read time from follows plus announcements rather than written out per
  /// follower, so there is nothing to mark read individually — and nothing that
  /// can be left pointing at an announcement that was since deleted.
  notificationsReadAt DateTime?

  reviews       Review[]
  discordLink   DiscordLink?
  passwordReset PasswordReset?

  announcements Announcement[]
  changelog     ChangelogEntry[]
  follows       Follow[]

  /// Teams this user develops with. Granted by an admin or by a team lead, so
  /// this is not a role: a user can lead one team and be an ordinary member
  /// everywhere else.
  teams TeamMember[]

  changeRequests         ListingChangeRequest[] @relation("ChangeRequestAuthor")
  reviewedChangeRequests ListingChangeRequest[] @relation("ChangeRequestReviewer")
}

/// A user following a listing, so its announcements reach them.
///
/// The composite primary key is the whole point: following twice is the same
/// fact as following once, and the database says so rather than the server
/// action having to check first.
model Follow {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  /// Announcements are read per follower, but a listing's follower count is
  /// read per listing.
  @@index([listingId])
}

/// A pending password reset, delivered as a code over Discord DM. One per user:
/// requesting again replaces the previous code. Deleted once used.
model PasswordReset {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// A pending Discord verification. One per user: requesting a new code replaces
/// the old one. Deleted once verified.
model DiscordLink {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Resolved by the bot at request time, so the code cannot be redeemed against
  // a different account than the one that was DM'd.
  discordId       String
  discordUsername String

  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Which of a team's members may do what.
///
/// Two roles rather than per-member permission flags: every check in the code
/// stays a single comparison, and the UI stays a dropdown. A third role can be
/// added later without touching any existing row, whereas splitting a flag set
/// back apart could not be done without deciding what every current member meant.
enum TeamRole {
  LEAD
  MEMBER
}

/// A development team.
///
/// Replaced `Listing.ownerId`, which could name exactly one person. A team can
/// hold several listings — one studio, several clients — and a solo developer is
/// simply a team of one.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  listings Listing[]
}

model TeamMember {
  teamId String
  userId String
  role   TeamRole @default(MEMBER)

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Membership is a fact about a pair, so the pair is the key: joining twice is
  /// the same as joining once, and the database says so.
  @@id([teamId, userId])
  /// "Which teams am I in" is asked on every listing page by a signed-in member.
  @@index([userId])
}

/// Whether a proposed listing edit is still waiting, and how it ended.
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An edit a team proposes to its own listing, for an admin to approve.
///
/// Teams do not write to `Listing` directly. The site's whole claim is that
/// somebody independent checked these entries, and that claim does not survive a
/// developer being able to rewrite their own description after being marked
/// trusted.
///
/// Stored as a full snapshot of the proposed listing rather than a diff. A diff
/// recorded now and applied later silently resolves against whatever the row has
/// become in the meantime; a snapshot is exactly what the admin was shown when
/// they approved. The cost is that an admin edit made while a request is open is
/// overwritten on approval — which is why the review screen shows the current
/// value beside every proposed one.
model ListingChangeRequest {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Cascade: an unattributed request is not something to act on.
  authorId String
  author   User   @relation("ChangeRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  name              String
  description       String
  developer         String?
  url               String
  secondaryUrl      String?
  urlLabel          String?
  secondaryUrlLabel String?
  features          String?
  pricing           Pricing?
  price             String?

  /// The team's explanation of what changed and why.
  note String?

  status       ChangeRequestStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?               @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Why an admin rejected it. Shown to the team — unlike a moderation note,
  /// this is feedback they are meant to act on.
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The queue reads pending first, and a listing shows its own history.
  @@index([status, createdAt])
  @@index([listingId])
}

model Listing {
  id                String   @id @default(cuid())
  name              String
  description       String
  category          String
  developer         String?
  url               String
  secondaryUrl      String?
  /// What the link button says, or null to derive it from the URL.
  ///
  /// Auto-detection reads the hostname, which is right until a developer points
  /// at their own domain: nebulaclient.net/discord is a Discord invite that
  /// detection can only call "Visit". This is the override for that.
  urlLabel          String?
  secondaryUrlLabel String?
  /// The developers' own feature list, as Markdown. Null when unwritten.
  ///
  /// Optional and empty for most listings — a client with nothing here is not
  /// incomplete, it simply has no feature list. Goes through the same approval
  /// as the description: it is the vendor describing their own product, and
  /// leaving it unreviewed would be a hole in exactly the rule that field sets.
  ///
  /// Rendered by src/lib/markdown.tsx, which builds React elements from a small
  /// subset rather than emitting HTML — see there for why that distinction is
  /// what makes developer-authored text safe to display.
  features          String?
  isTrusted         Boolean  @default(true)
  /// Nullable rather than defaulting to FREE: the existing listings have no
  /// pricing recorded, and claiming they are free would be inventing data about
  /// real entries. Unset simply shows no badge until an admin sets one.
  pricing           Pricing?
  /// What a paid listing actually costs, as free text — "5€ / month", "$15
  /// lifetime", "from 3€/mo". Deliberately not a number plus a currency: prices
  /// here mix currencies, billing periods and tiers, so a structured column
  /// would either lose information or force admins to lie. The tradeoff is that
  /// prices cannot be sorted or compared, only shown.
  ///
  /// Only meaningful when `pricing` is PAID or FREEMIUM; see
  /// src/lib/pricing.ts, which clears it otherwise.
  price             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// The development team behind this listing, or null while nobody claims it.
  ///
  /// Replaced a single `ownerId`. Deliberately a relation rather than a Role:
  /// membership is per team, so a global role would grant it everywhere.
  /// Which team a listing belongs to is set by an admin only — the `developer`
  /// field above is free text an admin typed and proves nothing, so it cannot be
  /// used to decide who may publish here.
  ///
  /// SetNull rather than Cascade: deleting a team must not take its listings
  /// down with it.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  changeRequests ListingChangeRequest[]

  /// When an admin pulled this listing from the public catalogue, or null while
  /// it is listed normally.
  ///
  /// A timestamp rather than a boolean because the state is meant to be
  /// temporary — pulled while an accusation is looked into — and "since when"
  /// is the first thing anyone reviewing the backlog asks. Deliberately not
  /// deletion: the reviews, the stats and the history stay, so relisting is one
  /// click and nothing is lost if the accusation does not hold up.
  unlistedAt     DateTime?
  /// Admin-facing note on why. Never rendered to the public — an unproven
  /// accusation is not something to publish under the hub's name.
  unlistedReason String?

  /// Discord webhook this listing's releases are mirrored to, or null.
  ///
  /// Set by the team so their own server gets a post whenever they publish a
  /// release here. Deliberately per listing rather than per team: a studio with
  /// several clients has a channel per client.
  ///
  /// This is a credential — whoever holds the URL can post into that channel —
  /// so it is never sent back to the browser in full; see maskWebhookUrl in
  /// src/lib/discord-webhook.ts. What may be stored here is restricted to real
  /// Discord webhook endpoints by parseWebhookUrl, because the server fetches
  /// this URL: an arbitrary one would make this field a way to aim the server at
  /// anything it can reach.
  changelogWebhookUrl String?

  reviews       Review[]
  stats         ListingStat[]
  announcements Announcement[]
  changelog     ChangelogEntry[]
  followers     Follow[]

  @@index([category])
  @@index([teamId])
}

/// One released version of a listing, as its developers described it.
///
/// Separate from Announcement rather than an optional `version` column on it,
/// because the two are read for different reasons and at different times: an
/// announcement is news that goes stale ("we are down tonight"), a changelog
/// entry is a permanent record someone scrolls back through to find when a bug
/// was fixed. Keeping them in one table would mean every changelog view had to
/// remember to filter, and the version history would be interleaved with
/// outages.
///
/// Not put through the change-request queue, for the same reason announcements
/// are not: release notes that need an admin to approve them before they appear
/// would be useless on the day of the release, and unlike the listing's own
/// description these are plainly attributed to the developer and move no rating.
model ChangelogEntry {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Cascade, like Announcement: an unattributed release note on a site that
  /// sells independent vetting is worse than none.
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Free text — "v2.4.1", "1.8.9 build 3", "Season 4". Deliberately not parsed
  /// into numbers: this space mixes semver, Minecraft versions and build tags,
  /// and a structured column would either lose information or force developers
  /// to lie about their own versioning.
  version String
  /// Markdown, rendered by src/lib/markdown.tsx. Unlike an announcement — which
  /// is one plain-text paragraph — release notes are a bullet list in every
  /// project that keeps one, so the formatting earns its place here.
  body    String

  /// When the release happened, which is not always when it was typed up. Set by
  /// the publisher, defaulting to now.
  releasedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Two orderings, because the two readers disagree about what "newest" means.
  /// The listing page shows the version history, which is ordered by when each
  /// release shipped. The notification feed asks what has appeared since someone
  /// last looked, which is `createdAt` — see getNotifications for why a
  /// backfilled entry must not be sorted by the date printed on it.
  @@index([listingId, releasedAt])
  @@index([listingId, createdAt])
}

/// A note published by a listing's verified owner — a release, an outage, a
/// warning about fake copies.
///
/// Kept apart from Review on purpose. A review is the community's verdict and
/// carries a rating; an announcement is the vendor talking about their own
/// product and must never move the score. Mixing them in one table would make
/// that separation a matter of remembering to filter.
model Announcement {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Cascade: if the account goes, so do its posts. An unattributed vendor
  /// announcement on a site that sells independent vetting is worse than none.
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The listing page reads the newest first and nothing else.
  @@index([listingId, createdAt])
}

/// Daily counters per listing.
///
/// Deliberately aggregated by day rather than stored as one row per event: an
/// event log would need an IP or a session id to be worth anything, which makes
/// it personal data and drags in consent banners and retention rules. A counter
/// answers "how many" without ever knowing "who", and stays small enough that
/// nobody has to think about pruning it — roughly one row per listing per day.
model ListingStat {
  id        String   @id @default(cuid())
  listingId String
  /// Midnight UTC of the day being counted. UTC rather than local time so the
  /// bucket a hit lands in does not shift twice a year.
  day       DateTime @db.Date
  views     Int      @default(0)
  clicks    Int      @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, day])
  @@index([day])
}

/// Daily counters for everything that is not a listing: site pages and file
/// downloads, keyed by a short stable slug rather than a raw URL so query
/// strings cannot fragment the counts.
model PageStat {
  id   String   @id @default(cuid())
  path String
  day  DateTime @db.Date
  hits Int      @default(0)

  @@unique([path, day])
  @@index([day])
}

model Review {
  id     String @id @default(cuid())
  rating Int // 1-5, validated in application code
  body   String

  userId    String
  listingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per user per listing; posting again edits the existing one.
  @@unique([userId, listingId])
  @@index([listingId])
}

/// One rate-limit bucket: a scope, a subject, and how many times it has tried.
///
/// In the database rather than in process memory because a bucket that resets on
/// deploy is not a limit — it is a suggestion, and this box restarts the app for
/// every release. It also keeps counting correctly if the app is ever run as
/// more than one process.
///
/// Rows are disposable. Nothing reads a bucket once its window has passed, and
/// `sweepRateLimits` in src/lib/rate-limit.ts drops the stale ones, so losing
/// this table costs nothing beyond forgetting who was mid-cooldown.
model RateLimit {
  /// Which limit this is — see LIMITS in src/lib/rate-limit.ts.
  scope String

  /// Who is being limited: an IP, an account, or both. Hashed by the caller, so
  /// this table cannot be read as a log of who tried to sign in and from where.
  key String

  /// Attempts inside the current window. Cleared by a success, not by time.
  attempts Int @default(0)

  /// When the current window opened. A window that has fully elapsed starts
  /// over rather than being extended.
  windowStart DateTime @default(now())

  /// Set once the limit is passed. The cooldown lengthens with each further
  /// attempt, so a mistyped password costs a moment and a script costs an hour.
  blockedUntil DateTime?

  @@id([scope, key])
  @@index([windowStart])
}
